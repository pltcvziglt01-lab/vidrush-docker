.env
app/render-studio/node_modules
app/render-studio/out
app/render-studio/public/isler
_kaynak_wf.json
vps-bootstrap.sh

# Faz D render ciktilari — dosyalar diskte KALIR, depoya girmez
cikti/
app/render-studio/public/editorv2/
app/render-studio/public/gerileme_testi/

# Faz E arastirma/medya onbellegi — yerel, depoya girmez
webapp/veri/onbellek/

# Yerel arac/test artiklari — depoya girmez (Faz F QA maddesi 5)
.claude/
# §14'un tarif ettigi yerel test venv'i — depoya girmez (Faz I-14)
.venv-test/

# Python bytecode / test onbellegi — depoya girmez (Faz H)
__pycache__/
*.py[cod]
.pytest_cache/

# Calisma zamani is durumu / gecici yuklemeler — depoya girmez (Faz H)
webapp/veri/durumlar/
webapp/veri/gecici/
webapp/ciktilar/

# ⚠ FAZ R-1d-a — SIRLAR VE CALISMA ZAMANI DEPOLARI DEPOYA GIRMEZ.
# R-1a'da `webapp/veri/.imza_anahtari` KAZAYLA COMMIT EDILDI (4846264):
# modulun kendi sozlesmesi "anahtar_repoda: False" diyordu ama test YANLIS
# YOLU (`webapp/.imza_anahtari`) kontrol ettigi icin yakalanmadi. Depoya
# erisen herkes o anahtarla HERHANGI bir tenant adina imza uretebilirdi.
# Anahtar izlemeden cikarildi ve DONDURULDU (yeniden uretiliyor).
webapp/veri/.imza_anahtari
webapp/veri/.oturum_anahtari
webapp/veri/kullanicilar.json
webapp/veri/kutuphane.json
webapp/veri/saglayicilar.json
webapp/veri/*_key.txt

# Faz I-11 render smoke ciktisi — IKILI dosyalar depoya girmez (~13 MB).
# `outputs/sample/README.md` ve `smoke_rapor.json` IZLENIR; video/kareler
# betik yerelde kosturularak yeniden uretilir.
outputs/sample/*.mp4
outputs/sample/*.png
cikti/_smoke_editorv2/
